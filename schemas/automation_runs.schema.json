{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tektizen.local/schemas/automation_runs.schema.json",
  "title": "automation_runs",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "workflow",
          "trigger",
          "started_at",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^run_[0-9a-z]{8,40}$"
          },
          "workflow": {
            "type": "string"
          },
          "github_run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "github_run_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "trigger": {
            "enum": [
              "schedule",
              "workflow_dispatch",
              "dashboard",
              "local",
              "push"
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "running",
              "success",
              "partial",
              "failed"
            ]
          },
          "ai_requests": {
            "type": "integer",
            "minimum": 0
          },
          "tokens": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "completion": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "log": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": [
                "at",
                "level",
                "message"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "level": {
                  "enum": [
                    "debug",
                    "info",
                    "warning",
                    "error"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
