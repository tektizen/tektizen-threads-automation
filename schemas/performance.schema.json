{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tektizen.local/schemas/performance.schema.json",
  "title": "performance",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "content_id",
          "collected_at",
          "metrics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^perf_[0-9a-z]{8,40}$"
          },
          "content_id": {
            "type": "string",
            "pattern": "^cnt_[0-9a-z]{8,40}$"
          },
          "zernio_post_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "metrics": {
            "type": "object",
            "required": [
              "views",
              "likes",
              "replies",
              "reposts",
              "quotes"
            ],
            "properties": {
              "views": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "likes": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "replies": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "reposts": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "quotes": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "shares": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "impressions": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "source": {
            "type": "string"
          },
          "raw_status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
