# Local development only. In GitHub Actions these come from repository Secrets.
# Never commit real values. Never prefix secrets with VITE_ — anything VITE_* is bundled into the public frontend.

# --- Automation engine (Python) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
ZERNIO_API_KEY=your-zernio-api-key-here
# Optional: sent to OpenRouter as attribution headers
OPENROUTER_APP_URL=https://your-dashboard.pages.dev
OPENROUTER_APP_NAME=TektiZen Content Intelligence

# --- Frontend (public, non-secret build-time config; optional — defaults to tektizen/tektizen-threads-automation@main) ---
# Repository the dashboard reads from and dispatches workflows to.
VITE_GITHUB_OWNER=tektizen
VITE_GITHUB_REPO=tektizen-threads-automation
VITE_GITHUB_BRANCH=main
